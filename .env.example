# Copy to .env and fill in the key:  cp .env.example .env
# Required. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── everything below is optional ────────────────────────────────────────

# Model fallback chain, comma-separated, tried in order. Attempt N uses
# model N, so a retry is also a failover to the next model. Default:
#   gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
#
# Chosen by measurement, not by version number. On a free-tier key,
# gemini-3.5-flash-lite answered in ~3.4s and never failed; gemini-3.8-flash
# returned 503 "high demand" on 2 of 6 probes at ~7s median; gemini-3.5-flash
# was reliable but took ~23s to score a batch of 8, which makes the refinement
# loop feel broken. Override to try others:
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# Per-call deadline in ms. Default 30000.
# LLM_TIMEOUT_MS=30000

# Where session state is stored. Default ./data/flexipal.db
# FLEXIPAL_DB=./data/flexipal.db

# Default 3539.
# PORT=3539
